{
  "name": "runninghub-multi-task-runner-core",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Desktop app for running workflows through the RunningHub API.",
  "main": "dist/src/desktop/main.js",
  "files": [
    "dist/",
    "frontend/dist/",
    "desktop/preload.cjs",
    "desktop/assets/",
    "bundled-workflows/",
    "prompt-skills/",
    "THIRD_PARTY_LICENSES/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run licenses:check && npm run package:verify && npm run native:node --silent && tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/integration.ts",
    "dev": "tsx scripts/dev.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "frontend:build": "npm --prefix frontend run build",
    "desktop:build": "npm run frontend:build && npm run build",
    "desktop:launch": "npm run download-engine:prepare && npm run native:ensure-electron && electron dist/src/desktop/main.js",
    "download-engine:prepare": "node scripts/prepare-download-engine.mjs",
    "native:node": "npm rebuild better-sqlite3",
    "native:electron": "electron-rebuild -f -w better-sqlite3",
    "native:ensure-electron": "node scripts/ensure-electron-native.mjs",
    "desktop:start": "npm run desktop:build && npm run desktop:launch",
    "desktop:smoke": "npm run desktop:build && npm run native:electron && electron dist/src/desktop/main.js --smoke",
    "release:win": "npm run download-engine:prepare && npm run desktop:build && npm run native:electron && electron-builder --win nsis --x64 --publish never",
    "release:mac": "npm run desktop:build && electron-builder --mac zip --arm64 --publish never",
    "release:mac:intel": "npm run desktop:build && electron-builder --mac zip --x64 --publish never",
    "licenses:generate": "node scripts/generate-third-party-licenses.mjs",
    "licenses:check": "node scripts/generate-third-party-licenses.mjs --check",
    "package:verify": "node scripts/verify-package-boundaries.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "ai.runninghub.runner",
    "productName": "RunningHub Runner",
    "asar": true,
    "directories": {
      "output": "release-build"
    },
    "files": [
      "dist/src/**/*",
      "!dist/src/cloud/**/*",
      "frontend/dist/**/*",
      "desktop/preload.cjs",
      "desktop/assets/**/*",
      "bundled-workflows/**/*",
      "prompt-skills/**/*",
      "package.json"
    ],
    "extraResources": [
      "README.md",
      "THIRD_PARTY_LICENSES/**/*"
    ],
    "mac": {
      "icon": "desktop/assets/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "RunningHub-Runner-v${version}-macos-${arch}.${ext}",
      "category": "public.app-category.video",
      "identity": "-",
      "notarize": false
    },
    "win": {
      "extraResources": [
        {
          "from": "download-engine",
          "to": "download-engine",
          "filter": [
            "**/*"
          ]
        }
      ],
      "icon": "desktop/assets/icon.ico",
      "artifactName": "RunningHub-Runner-v${version}-windows-x64-setup.${ext}",
      "publish": [
        {
          "provider": "github",
          "owner": "chiqi51386-afk",
          "repo": "RunningHub-Multi-Task-Runner"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "shortcutName": "RunningHub Runner"
    }
  }
}
